# Copy to .env (repo root, read by docker compose) and, for the CLI outside
# Docker, also to backend/.env. Never commit the real .env.

# ── Strava API (required) ────────────────────────────────────────────────────
# Create your own app at https://www.strava.com/settings/api
# "Authorization Callback Domain": localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Port of the local OAuth callback used by `strava-dash auth`
STRAVA_REDIRECT_PORT=8888

# ── Storage ──────────────────────────────────────────────────────────────────
# SQLite file. docker-compose.yml pins it to /data/strava.db (the mounted ./data
# folder); only change it when running the backend outside Docker.
DB_PATH=/data/strava.db
BACKEND_PORT=8000

# ── Athlete values (leave empty or 0 to auto-detect from your training) ──────
# FTP in watts — auto: best 20 min of the last 90 days × 0.95
FTP_W=
# Run threshold pace in m/s (e.g. 4.17 = 4:00 /km) — auto: fastest hard 20+ min run
THRESHOLD_PACE_MS=
# Max heart rate (bpm) — auto: highest HR held ≥ 10 s in the last 12 months
MAX_HR=
# Resting heart rate (bpm), used for HR-based TSS
REST_HR=40

# ── Wind page ────────────────────────────────────────────────────────────────
# City switcher, "Name:lat:lng" comma-separated. Empty = wind at each segment.
WIND_CITIES=
# WIND_CITIES=Munich:48.14:11.58,Berlin:52.52:13.40

# ── Network ──────────────────────────────────────────────────────────────────
# Where the BROWSER reaches the backend (baked into the frontend at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Origins allowed to call the API (your dashboard URL), or "*" on a trusted LAN
CORS_ORIGINS=http://localhost:3000

# ── MCP server (AI coach) ────────────────────────────────────────────────────
# Serve MCP over Streamable HTTP at /mcp (1 = on, 0 = off)
MCP_HTTP_ENABLED=1
# Extra hosts MCP clients may use to reach /mcp, e.g. "192.168.1.50:*"
MCP_ALLOWED_HOSTS=
